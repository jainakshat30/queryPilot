# Copy to .env (git-ignored) and fill the empty passwords with:
#   for v in POSTGRES_PASSWORD QP_APP_PASSWORD QP_READER_PASSWORD; do
#     sed -i '' "s|^$v=.*|$v=$(openssl rand -hex 24)|" .env
#   done
# Never commit real values.

PGHOST=127.0.0.1
PGPORT=54329

# Superuser: used only by docker compose, db setup, and tests. Never by the app at runtime.
POSTGRES_PASSWORD=
# App role (qp_app database: history, metrics, evals).
QP_APP_PASSWORD=
# Read-only role that executes generated SQL against qp_sales.
QP_READER_PASSWORD=

# fake (default, deterministic, offline) | anthropic | gemini
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
